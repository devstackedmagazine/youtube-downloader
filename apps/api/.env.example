# All settings live in app/config.py. Dummy values only — never commit real ones.
ENVIRONMENT=development

# Redis: job state, rate limiting and Celery broker. Use rediss:// (TLS) for Upstash,
# e.g. rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:6379/0
# Optional; both fall back to REDIS_URL when empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Comma-separated allowed browser origins (first = production frontend).
FRONTEND_URL=http://localhost:3000
# Optional regex for Vercel preview deployments, scoped to this project + team slug, e.g.
# ^https://dltube-[a-z0-9-]+-<team-slug>\.vercel\.app$
CORS_ORIGIN_REGEX=
# Comma-separated Host headers the API answers to ("*" disables the check).
# On Render the service's onrender.com host (RENDER_EXTERNAL_HOSTNAME, set by Render) is
# added automatically; list only extra hosts such as a custom domain.
TRUSTED_HOSTS=localhost,127.0.0.1

DOWNLOAD_DIR=tmp_downloads
MAX_PLAYLIST_ITEMS=100
# Longest video or section (seconds) the server will process.
MAX_DURATION_SECONDS=1800
METADATA_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Header with the real client IP, set by a proxy that overwrites client values.
# Render (Cloudflare in front): cf-connecting-ip. Empty = socket peer (local / plain Docker).
CLIENT_IP_HEADER=

# Comma-separated yt-dlp YouTube player clients; empty = yt-dlp's maintained defaults.
YT_PLAYER_CLIENTS=
# Optional proxy for YouTube traffic when YouTube blocks the server IP ("not a bot").
# Secret if it holds credentials: http://user:pass@host:port
YT_PROXY=

# start.sh: Celery child is recycled after a task once it exceeds this (KiB).
CELERY_MAX_MEMORY_KB=150000

# Port uvicorn listens on. Render sets it (default 10000); unset means 8000.
# PORT=8000

# Heap cap for Deno, yt-dlp's YouTube challenge solver (~215 MB RSS). Leave unset with
# >= 512 MB of RAM; on 256 MB use --max-old-space-size=64 so it fails fast instead.
# DENO_V8_FLAGS=
