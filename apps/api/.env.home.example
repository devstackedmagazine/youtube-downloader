# Settings for docker-compose.home.yml. Copy to .env.home (gitignored) and fill in.
# Dummy values only; never commit the real file.
ENVIRONMENT=production
PORT=8000

# Upstash (must be rediss://). All three can be the same URL.
REDIS_URL=rediss://default:<upstash-token>@<name>.upstash.io:6379
CELERY_BROKER_URL=rediss://default:<upstash-token>@<name>.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:<upstash-token>@<name>.upstash.io:6379

# Browser origin of the frontend (CORS).
FRONTEND_URL=https://dltube.vercel.app
# Optional regex for Vercel previews; empty disables it.
CORS_ORIGIN_REGEX=
# The Funnel host Vercel calls, from `tailscale funnel status`. localhost stays for health checks.
TRUSTED_HOSTS=<machine>.<tailnet>.ts.net,localhost,127.0.0.1

# Tailscale Funnel overwrites X-Forwarded-For with the real client IP, so trust it
# here. Only safe because the port is bound to 127.0.0.1 and reached through Funnel.
CLIENT_IP_HEADER=x-forwarded-for

DOWNLOAD_DIR=/app/tmp_downloads
MAX_PLAYLIST_ITEMS=100
MAX_DURATION_SECONDS=1800
METADATA_TIMEOUT_SECONDS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
YT_PLAYER_CLIENTS=
# Unused at home (no paid proxy); leave empty.
YT_PROXY=
CELERY_MAX_MEMORY_KB=150000
