{
  "name": "youtube-downloader",
  "version": "0.1.0",
  "description": "Free YouTube video downloader - MP4 & MP3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "postcss": "8.5.23"
    }
  }
}
