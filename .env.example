# Public URL served by the frontend. Do not include a trailing slash.
FRONTEND_URL=http://localhost:3000

# URL compiled into the frontend bundle. Use your public API URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated Host headers accepted by the API.
TRUSTED_HOSTS=localhost,127.0.0.1

# Safety limits for anonymous, resource-intensive download operations.
MAX_PLAYLIST_ITEMS=100
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
